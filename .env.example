VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=https://astoryapp.com

# Analytics. Leave both unset and nothing loads — no script, no cookie, no
# request. Set the domain to switch it on; the src defaults to Plausible and
# can point at any drop-in compatible provider (Fathom, self-hosted Plausible).
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SRC=
